# Secrets
.env
*.key

# Data and outputs
runs/
media/
*.mp4
*.mov
*.wav
*.mp3
# Benchmark measurements are the deliverable, so results are versioned. The
# directory cannot be excluded outright or git never descends far enough to see
# evals/shotbench/.gitignore, which re-includes only .jsonl — the rule that
# stops a stray .env or a downloaded weight riding along in a bulk `git add`.
evals/shotbench/results/*
!evals/shotbench/results/*.jsonl
evals/shotbench/shotbench_data/

# Golden fixtures are append-only but their media is large; track with LFS or
# keep out of git and document provenance in evals/golden/<name>/notes.md
evals/golden/**/assets/
evals/golden/**/*.mp4

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# Locally installed agent skills (third-party, ~11MB). Tooling, not deliverable.
.agents/
.claude/

# Original brief archives; contents are extracted as .md in the repo root.
*.zip

# Personal working document — kept locally, never published.
PROJECT_DECISION_LOG.md

# graphify code graph — generated, regenerate with: graphify update .
graphify-out/

# Pre-parser-fix result snapshots, kept locally as evidence, not worth versioning
evals/shotbench/results/*.prefix-backup

# Extracted reel frames: regenerable from the source videos with
# `python evals/reels/make_page.py`, and large. The labels are the artefact
# worth versioning, not the JPEGs.
evals/reels/frames/*.jpg
evals/reels/labeller.html
evals/reels/frames_shots/
evals/reels/sheets/
