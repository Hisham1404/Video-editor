# Copy to .env and fill in. .env is gitignored; never commit a real key.

# Stage 3 vision model. Only needed while the vision stage is a hosted API --
# a local ShotVL would remove this entirely.
GEMINI_API_KEY=

# Optional overrides
# VISION_MODEL=gemini-3.5-flash-lite
# BEAT_MODEL=beat_this
# EMBED_MODEL=clip-vit-base-patch32

# Used by costlog to price local GPU time. Shadeform RTX 4090 on-demand was
# $0.46/hr on 2026-09-10 ($0.18 spot).
# GPU_USD_PER_HOUR=0.46
